# ============================================================
# Inter-Office Memo Management System - Environment Variables
# ============================================================

# --- DATABASE ---
# Local development (SQLite):
#   DATABASE_URL="file:./dev.db"
#
# Production / Render (PostgreSQL - auto-filled by render.yaml):
#   DATABASE_URL="postgresql://user:password@host:5432/memo_system"
DATABASE_URL="postgresql://user:password@host:5432/memo_system"

# --- AUTHENTICATION ---
# A strong random secret for signing JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-string-at-least-32-chars"

# --- ENVIRONMENT ---
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
